<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_checklist_template_list" model="ir.ui.view">
        <field name="name">project.checklist.template.list</field>
        <field name="model">project.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="item_count" string="Items"/>
            </list>
        </field>
    </record>

    <record id="view_checklist_template_form" model="ir.ui.view">
        <field name="name">project.checklist.template.form</field>
        <field name="model">project.checklist.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. QA Checklist"/>
                        </h1>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name" placeholder="Checklist item..."/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">project.checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a reusable checklist template
            </p>
            <p>
                Templates can be applied to any task from its Checklist tab,
                without affecting other tasks using the same template.
            </p>
        </field>
    </record>

    <menuitem id="menu_checklist_template"
              name="Checklist Templates"
              action="action_checklist_template"
              parent="project.menu_project_config"
              groups="project.group_project_manager"
              sequence="60"/>

</odoo>
