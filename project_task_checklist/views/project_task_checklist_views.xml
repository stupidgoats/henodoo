<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Own form view for a single checklist. Used both as the popup shown
         when clicking into a checklist from the task's Checklist tab, and
         as the "Add a line" quick-create dialog. Because a checklist's
         items (line_ids) are its own direct children here, the done/total
         counts recompute live as items are checked - the same reliable
         pattern the task-level progress bar already relies on. -->
    <record id="view_task_checklist_form" model="ir.ui.view">
        <field name="name">project.task.checklist.form</field>
        <field name="model">project.task.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist">
                <sheet>
                    <field name="task_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. QA Checklist"/>
                        </h1>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <field name="progress" widget="progressbar" readonly="1" nolabel="1"
                               style="width: 240px;"/>
                        <span class="text-muted ms-3">
                            <field name="progress_label" readonly="1" nolabel="1" class="oe_inline"/>
                            done
                        </span>
                        <button name="action_reset_checklist" type="object"
                                string="Reset Checklist" class="btn-link ms-auto"
                                confirm="Uncheck every item on this checklist?"
                                invisible="not total_count"/>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="is_done"/>
                            <field name="name" placeholder="Checklist item..."/>
                            <field name="done_by" column_invisible="1"/>
                            <field name="done_date" column_invisible="1"/>
                            <control>
                                <create string="Add a checklist item"/>
                            </control>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Add a "Checklist" tab to the task form -->
    <record id="view_task_form2_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.form.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <page name="description_page" position="after">
                <page name="checklist_page" string="Checklist">
                    <div class="d-flex align-items-center mb-2">
                        <div class="d-flex align-items-center" invisible="not checklist_total_count">
                            <field name="checklist_progress" widget="progressbar" readonly="1" nolabel="1"
                                   style="width: 240px;"/>
                            <span class="text-muted ms-3">
                                <field name="checklist_done_count" readonly="1" nolabel="1" class="oe_inline"/>
                                /
                                <field name="checklist_total_count" readonly="1" nolabel="1" class="oe_inline"/>
                                done
                            </span>
                        </div>
                        <button name="%(project_task_checklist.action_checklist_template_apply)d"
                                type="action" string="Add Checklist from Template"
                                class="btn-link ms-auto" context="{'default_task_id': id}"/>
                        <button name="action_reset_checklist" type="object"
                                string="Reset All Checklists" class="btn-link ms-2"
                                confirm="Uncheck every item across every checklist on this task?"
                                invisible="not checklist_total_count"/>
                    </div>
                    <field name="checklist_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="progress_label" string="Done"/>
                            <field name="progress" widget="progressbar"/>
                            <control>
                                <create string="Add a checklist"/>
                            </control>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <!-- Small progress indicator on the kanban card -->
    <record id="view_task_kanban_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.kanban.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="checklist_total_count"/>
                <field name="checklist_done_count"/>
                <field name="checklist_progress"/>
            </xpath>
            <xpath expr="//t[@t-name='card']//footer" position="before">
                <div t-if="record.checklist_total_count.raw_value"
                     class="d-flex align-items-center gap-1 text-muted small mb-1">
                    <i class="fa fa-check-square-o" title="Checklist"/>
                    <span>
                        <t t-esc="record.checklist_done_count.raw_value"/>/<t t-esc="record.checklist_total_count.raw_value"/>
                    </span>
                    <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded" style="height: 4px; min-width: 24px;">
                        <div class="bg-success rounded"
                             t-attf-style="height: 4px; width: #{record.checklist_progress.raw_value}%;"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
