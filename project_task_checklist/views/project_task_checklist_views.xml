<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Generic form view for project.task.checklist. The task's own
         Checklist tab no longer uses this - it renders checklists inline
         via the checklist_accordion widget (see
         static/src/js/checklist_accordion_field.js) so items can be
         checked off without leaving the task. This view is kept as the
         model's default form, e.g. for technical/backend access to a
         checklist record directly. -->
    <record id="view_task_checklist_form" model="ir.ui.view">
        <field name="name">project.task.checklist.form</field>
        <field name="model">project.task.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist">
                <sheet>
                    <field name="task_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. QA Checklist"/>
                        </h1>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <field name="progress" widget="progressbar" readonly="1" nolabel="1"
                               style="width: 240px;"/>
                        <span class="text-muted ms-3">
                            <field name="progress_label" readonly="1" nolabel="1" class="oe_inline"/>
                            resolved
                        </span>
                        <button name="action_reset_checklist" type="object"
                                string="Reset Checklist" class="btn-link ms-auto"
                                confirm="Set every item on this checklist back to Pending?"
                                invisible="not total_count"/>
                    </div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-muted="state == 'not_needed'"
                                   decoration-info="state == 'pending'"/>
                            <field name="name" placeholder="Checklist item..."/>
                            <field name="resolved_by" column_invisible="1"/>
                            <field name="resolved_date" column_invisible="1"/>
                            <control>
                                <create string="Add a checklist item"/>
                            </control>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Add a "Checklist" tab to the task form -->
    <record id="view_task_form2_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.form.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <page name="description_page" position="after">
                <page name="checklist_page" string="Checklist">
                    <field name="checklist_ids" widget="checklist_accordion"/>
                </page>
            </page>
        </field>
    </record>

    <!-- Small progress indicator on the kanban card -->
    <record id="view_task_kanban_inherit_checklist" model="ir.ui.view">
        <field name="name">project.task.kanban.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="checklist_total_count"/>
                <field name="checklist_done_count"/>
                <field name="checklist_not_needed_count"/>
                <field name="checklist_pending_count"/>
                <field name="checklist_progress"/>
            </xpath>
            <xpath expr="//t[@t-name='card']//footer" position="before">
                <div t-if="record.checklist_total_count.raw_value"
                     class="d-flex align-items-center gap-2 text-muted small mb-1"
                     title="Checklist items: complete / not needed / pending">
                    <span class="d-flex align-items-center gap-1 text-success"
                          t-if="record.checklist_done_count.raw_value">
                        <i class="fa fa-check-square-o"/>
                        <t t-esc="record.checklist_done_count.raw_value"/>
                    </span>
                    <span class="d-flex align-items-center gap-1"
                          t-if="record.checklist_not_needed_count.raw_value">
                        <i class="fa fa-minus-square-o"/>
                        <t t-esc="record.checklist_not_needed_count.raw_value"/>
                    </span>
                    <span class="d-flex align-items-center gap-1"
                          t-if="record.checklist_pending_count.raw_value">
                        <i class="fa fa-square-o"/>
                        <t t-esc="record.checklist_pending_count.raw_value"/>
                    </span>
                    <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded" style="height: 4px; min-width: 24px;">
                        <div class="bg-success rounded"
                             t-attf-style="height: 4px; width: #{record.checklist_progress.raw_value}%;"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
