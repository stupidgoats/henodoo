<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= Form view ================= -->
    <!-- For a task that has at least one checklist, the checklist moves to
         the very top of the form - right under the task name - and the
         "Checklist" notebook tab disappears (it would just be a duplicate).
         For a task with no checklist yet, nothing changes: the form looks
         exactly as it always has, with a "Checklist" tab (first in the
         notebook) where the first checklist can be added. Once that first
         checklist is created and the form reloads, checklist_total_count
         flips from 0, and the widget "moves" from the tab to the top. -->
    <record id="view_task_form2_checklist" model="ir.ui.view">
        <field name="name">project.task.form.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <field name="checklist_total_count" invisible="1"/>
                <div class="o_checklist_form_top" invisible="not checklist_total_count">
                    <field name="checklist_ids" widget="checklist_accordion" nolabel="1"/>
                </div>
            </xpath>

            <xpath expr="//notebook/page[1]" position="before">
                <page string="Checklist" name="checklist" invisible="checklist_total_count">
                    <field name="checklist_ids" widget="checklist_accordion" nolabel="1"/>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ================= Kanban view ================= -->
    <!-- Shows a compact done/not-needed/pending badge row plus the actual
         checklist items - each with its own checkbox you can click right on
         the card to mark it Complete, no need to open the task. -->
    <record id="view_task_kanban_checklist" model="ir.ui.view">
        <field name="name">project.task.kanban.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">

            <xpath expr="//kanban/templates" position="before">
                <field name="checklist_total_count"/>
                <field name="checklist_done_count"/>
                <field name="checklist_not_needed_count"/>
                <field name="checklist_pending_count"/>
            </xpath>

            <xpath expr="//t[@t-name='card']" position="inside">
                <div class="o_checklist_kanban_wrap" t-if="record.checklist_total_count.value">
                    <div class="o_checklist_kanban_summary d-flex align-items-center">
                        <span class="text-success me-2" t-if="record.checklist_done_count.value">
                            <i class="fa fa-check-square-o"/> <t t-esc="record.checklist_done_count.value"/>
                        </span>
                        <span class="text-danger me-2" t-if="record.checklist_not_needed_count.value">
                            <i class="fa fa-times-circle"/> <t t-esc="record.checklist_not_needed_count.value"/>
                        </span>
                        <span t-if="record.checklist_pending_count.value">
                            <i class="fa fa-square-o"/> <t t-esc="record.checklist_pending_count.value"/>
                        </span>
                    </div>
                    <field name="checklist_ids" widget="checklist_kanban"/>
                </div>
            </xpath>

        </field>
    </record>

</odoo>
